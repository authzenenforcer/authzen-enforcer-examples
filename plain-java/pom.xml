<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.authzenenforcer.examples</groupId>
    <artifactId>plain-java</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>authzen-enforcer example: plain Java</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <authzen-enforcer.version>0.2.0</authzen-enforcer.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>

        <!-- Where the example finds the PDP and the token endpoint. The defaults fit the Keycloak
             of compose.yaml; override any of them on the command line, such as -Dpdp.url=...
             The client secret is read from the DOCUMENT_PORTAL_CLIENT_SECRET environment variable. -->
        <pdp.url>http://127.0.0.1:8080/realms/authzen-examples</pdp.url>
        <token.url>${pdp.url}/protocol/openid-connect/token</token.url>
        <client.id>document-portal</client.id>
        <!-- Used to show the fail-closed behaviour; nothing should answer there -->
        <unreachable.pdp.url>http://127.0.0.1:9</unreachable.pdp.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.authzenenforcer</groupId>
                <artifactId>authzen-enforcer-bom</artifactId>
                <version>${authzen-enforcer.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.authzenenforcer</groupId>
            <artifactId>authzen-enforcer-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <mainClass>io.github.authzenenforcer.examples.plainjava.PlainJavaExample</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>pdp.url</key>
                            <value>${pdp.url}</value>
                        </systemProperty>
                        <systemProperty>
                            <key>token.url</key>
                            <value>${token.url}</value>
                        </systemProperty>
                        <systemProperty>
                            <key>client.id</key>
                            <value>${client.id}</value>
                        </systemProperty>
                        <systemProperty>
                            <key>unreachable.pdp.url</key>
                            <value>${unreachable.pdp.url}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
